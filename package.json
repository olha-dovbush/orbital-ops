{
  "name": "orbital-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint src scripts --max-warnings 0",
    "dupcheck": "jscpd src",
    "validate:structure": "tsx scripts/validate.ts",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run dupcheck && npm run validate:structure"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jscpd": "^4.0.5",
    "jsdom": "^27.0.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.1",
    "vitest": "^4.0.8"
  }
}
